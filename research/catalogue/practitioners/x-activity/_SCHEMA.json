{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X Activity Monthly Shard",
  "description": "Monthly collection of a practitioner's X/Twitter posts, scored and classified for the knowledge catalogue.",
  "type": "object",
  "required": ["handle", "practitioner_ref", "month", "synced_at", "posts"],
  "properties": {
    "handle": {
      "type": "string",
      "description": "X handle without @ prefix"
    },
    "practitioner_ref": {
      "type": "string",
      "description": "Relative path to practitioner profile .md file (null if none exists)",
      "nullable": true
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "YYYY-MM of this shard"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last sync"
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "date", "text", "topics", "relevance", "signal_tier"],
        "properties": {
          "id": {
            "type": "string",
            "description": "X post ID (numeric string from URL)"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Full X post URL"
          },
          "type": {
            "type": "string",
            "enum": ["post", "reply", "quote", "repost", "thread"],
            "description": "Post type"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD publication date"
          },
          "text": {
            "type": "string",
            "description": "Full post text (max 500 chars for storage efficiency)"
          },
          "media": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Media URLs (images, videos)"
          },
          "metrics": {
            "type": "object",
            "properties": {
              "likes": { "type": "integer" },
              "retweets": { "type": "integer" },
              "replies": { "type": "integer" },
              "views": { "type": "integer" },
              "bookmarks": { "type": "integer" },
              "quotes": { "type": "integer" }
            }
          },
          "links": {
            "type": "array",
            "items": { "type": "string", "format": "uri" },
            "description": "External URLs mentioned in the post"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "agent-orchestration", "multi-agent", "claude-code", "coding-tools",
                "llm-engineering", "context-engineering", "prompt-engineering",
                "saas-business", "ai-economics", "ai-ops", "devops", "lead-gen",
                "marketing", "observability", "memory-systems", "mcp", "a2a-protocol",
                "infrastructure", "research", "rust", "security", "open-source",
                "personal", "off-topic"
              ]
            },
            "description": "1-5 topic tags from controlled vocabulary"
          },
          "relevance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Relevance score to our interest space"
          },
          "signal_tier": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW", "NOISE"],
            "description": "Signal classification tier"
          },
          "ingest_candidate": {
            "type": "boolean",
            "description": "Whether this post deserves a full /ingest-post catalogue entry"
          },
          "ingested": {
            "type": "boolean",
            "description": "Whether a full catalogue entry has been created"
          },
          "catalogue_path": {
            "type": "string",
            "nullable": true,
            "description": "Path to catalogue entry if ingested"
          },
          "enriched": {
            "type": "boolean",
            "description": "Whether fxtwitter enrichment succeeded"
          },
          "notes": {
            "type": "string",
            "description": "Agent or human annotations"
          }
        }
      }
    }
  }
}
